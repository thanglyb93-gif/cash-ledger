# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never exposed to the browser. Used by lib/supabase/admin.ts
# and scripts/seed-org.ts. Keep this out of NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (console.anthropic.com) -- used by lib/claude.ts for receipt extraction
ANTHROPIC_API_KEY=
